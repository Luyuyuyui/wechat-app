page{background:#f4f0e8;color:#20242c;font-family:"PingFang SC",Arial,sans-serif;font-size:28rpx}.page{padding:32rpx 32rpx 56rpx}.nav-gap{height:12rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#8d3c3c;font-weight:600}.page-title{font-size:54rpx;line-height:1.2;font-weight:700;letter-spacing:2rpx;margin-top:12rpx}.page-en{font-size:20rpx;letter-spacing:4rpx;color:#727882;margin-top:10rpx}.intro{font-size:27rpx;line-height:1.8;color:#4f555e}.section{margin-top:76rpx}.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:28rpx}.section-title{font-size:38rpx;font-weight:700}.section-en{font-size:18rpx;color:#7b8087;letter-spacing:2rpx}.line{height:1rpx;background:#d5d0c7}.ghost-btn{border:1rpx solid #263750;padding:17rpx 26rpx;display:inline-flex;gap:12rpx;align-items:center;font-size:25rpx;color:#1c2d47}.metal-card{background:linear-gradient(135deg,#e5e6e4,#b7bdc2 45%,#e8e5de);border-radius:6rpx;box-shadow:0 12rpx 30rpx rgba(23,36,54,.10)}.card{background:#faf8f3;border-radius:8rpx;overflow:hidden;box-shadow:0 10rpx 25rpx rgba(25,38,60,.06)}.tag{font-size:19rpx;letter-spacing:2rpx;color:#8d3c3c;border:1rpx solid rgba(141,60,60,.25);padding:7rpx 12rpx}.placeholder{position:relative;overflow:hidden;background:linear-gradient(135deg,#263750,#75818c 50%,#c2c6c6);color:#fff}.placeholder:after{content:"";position:absolute;width:360rpx;height:360rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:50%;right:-120rpx;top:-125rpx}.placeholder-word{position:relative;z-index:1;font-size:30rpx;letter-spacing:6rpx;font-weight:600}.placeholder-note{position:relative;z-index:1;font-size:21rpx;margin-top:14rpx;color:rgba(255,255,255,.82)}.placeholder-type{position:relative;z-index:1;font-size:18rpx;letter-spacing:3rpx;opacity:.7}.play{width:78rpx;height:78rpx;border-radius:50%;border:1rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:27rpx}.muted{color:#737981}.empty{padding:48rpx 30rpx;text-align:center;border:1rpx dashed #b8b5af;color:#74787d;font-size:25rpx}.safe-bottom{height:30rpx}
