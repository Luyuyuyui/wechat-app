.media{position:relative;overflow:hidden;border-radius:6rpx;background:#1c2d47;color:#fff}
.bg{position:absolute;inset:0;width:100%;height:100%;display:block}
.scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,30,40,.0) 55%,rgba(20,30,40,.55))}
.chip{position:absolute;left:18rpx;top:18rpx;background:rgba(141,60,60,.85);color:#fff;font-size:18rpx;letter-spacing:2rpx;padding:7rpx 13rpx;z-index:1}
.caption{position:absolute;left:22rpx;right:22rpx;bottom:18rpx;font-size:22rpx;color:rgba(255,255,255,.9);letter-spacing:1rpx;z-index:1}
.placeholder{position:relative;overflow:hidden;background:linear-gradient(135deg,#263750,#75818c 50%,#c2c6c6);color:#fff;width:100%;height:100%}
.placeholder:after{content:"";position:absolute;width:360rpx;height:360rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:50%;right:-120rpx;top:-125rpx}
.placeholder-type{position:relative;z-index:1;font-size:18rpx;letter-spacing:3rpx;opacity:.7;padding:30rpx 30rpx 0}
.placeholder-word{position:relative;z-index:1;font-size:30rpx;letter-spacing:6rpx;font-weight:600;padding:0 30rpx}
.play{position:absolute;z-index:2;width:78rpx;height:78rpx;border-radius:50%;border:1rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:27rpx;left:50%;top:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.25)}
.placeholder-note{position:absolute;z-index:1;font-size:21rpx;bottom:22rpx;left:30rpx;color:rgba(255,255,255,.82)}