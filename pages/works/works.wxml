<view class="page">
  <view class="eyebrow">SILVER ART</view>
  <view class="page-title">银饰之美</view>
  <view class="page-en">WORKS IN THE ARCHIVE</view>
  <view class="intro lead">马贵兵老师的代表性作品，涵盖工艺品、银饰与工艺画三个类别。</view>

  <scroll-view scroll-x class="tabs">
    <view class="tab-row">
      <block wx:for="{{tabs}}" wx:key="*this">
        <view class="tab {{active===item?'active':''}}" bindtap="filter" data-tab="{{item}}">{{item}}</view>
      </block>
    </view>
  </scroll-view>

  <view class="gallery">
    <block wx:for="{{filtered}}" wx:key="id">
      <view class="work-item" bindtap="go" data-id="{{item.id}}">
        <view class="work-img">
          <image src="{{item.cover}}" mode="aspectFill" />
          <view class="work-type">{{item.type}}</view>
        </view>
        <view class="work-copy">
          <view class="work-name">{{item.name}}</view>
          <view class="work-intro">{{item.basicInfo}}</view>
        </view>
      </view>
    </block>
  </view>
</view>