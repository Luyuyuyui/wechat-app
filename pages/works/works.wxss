.lead{margin-top:38rpx}
.tabs{margin:30rpx -32rpx 36rpx}
.tab-row{display:flex;gap:14rpx;padding:0 32rpx}
.tab{flex:none;padding:13rpx 22rpx;background:#e4e0d8;color:#737981;font-size:23rpx;border-radius:30rpx}
.tab.active{background:#223550;color:#fff}

.gallery{column-count:2;column-gap:18rpx;margin-top:10rpx}
.work-item{break-inside:avoid;margin-bottom:18rpx;background:#faf8f3;border-radius:6rpx;overflow:hidden;box-shadow:0 6rpx 18rpx rgba(25,38,60,.06)}
.work-img{position:relative}
.work-img image{width:100%;height:300rpx;display:block}
.work-type{position:absolute;right:16rpx;top:16rpx;background:rgba(35,53,80,.85);color:#fff;font-size:18rpx;letter-spacing:2rpx;padding:6rpx 12rpx;border-radius:2rpx}
.work-copy{padding:20rpx 22rpx 24rpx}
.work-name{font-size:28rpx;font-weight:700}
.work-intro{margin-top:10rpx;font-size:21rpx;line-height:1.7;color:#555d66;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}