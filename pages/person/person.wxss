.label{font-size:20rpx;color:#8d3c3c;letter-spacing:3rpx}
.small{font-size:34rpx;margin-top:12rpx}

.hero-strip{position:relative;height:520rpx;margin:0 -32rpx 30rpx;overflow:hidden;color:#fff}
.hero-strip image{position:absolute;inset:0;width:100%;height:100%}
.hero-mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.0) 30%,rgba(0,0,0,.7) 100%)}
.hero-text{position:absolute;left:36rpx;right:36rpx;bottom:36rpx;z-index:2}
.light{color:#e5d5cd}
.hero-name{font-size:60rpx;font-weight:700;letter-spacing:4rpx;margin-top:14rpx}
.hero-sub{margin-top:10rpx;font-size:24rpx;opacity:.9}

.timeline{margin-top:24rpx;border-left:1rpx solid #aeb1b2}
.dot{width:12rpx;height:12rpx;background:#8d3c3c;border-radius:50%;margin-left:-6rpx}
.stage{padding:0 0 32rpx 26rpx;font-size:30rpx;font-weight:600;position:relative;top:-9rpx}
.stage-body{font-size:24rpx;font-weight:400;color:#555d66;line-height:1.85;margin-top:10rpx}

.honor{background:#e7e3da;padding:30rpx;margin:30rpx -32rpx;border-radius:0}
.honor .section-title{margin-bottom:18rpx}
.honor-block{margin-bottom:22rpx}
.honor-block:last-child{margin-bottom:0}
.honor-label{font-size:24rpx;font-weight:700;color:#263750;letter-spacing:2rpx;margin-bottom:10rpx}
.honor-line{font-size:24rpx;line-height:1.9;color:#3f464e}

.teaching-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:18rpx}
.teaching-card{background:#faf8f3;border-radius:6rpx;overflow:hidden}
.teaching-card image{width:100%;height:280rpx;display:block}
.teaching-cap{padding:14rpx 18rpx;font-size:21rpx;color:#3f464e;line-height:1.55}

.media-list{margin-top:18rpx;border-top:1rpx solid #cbc7bf}
.media-row{padding:22rpx 0;border-bottom:1rpx solid #cbc7bf;font-size:27rpx;color:#263750;letter-spacing:1rpx}

.safe-bottom{height:60rpx}