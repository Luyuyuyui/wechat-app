<view class="page">
  <view class="head">
    <view class="tag">{{article.category}}</view>
    <view class="page-title article-h">{{article.title}}</view>
    <view class="meta">{{article.author}}　·　{{article.date}}</view>
  </view>

  <view class="cover">
    <image src="{{article.cover}}" mode="aspectFill" />
  </view>

  <view class="body">
    <block wx:for="{{article.body}}" wx:key="index">
      <view class="para">{{item}}</view>
    </block>
  </view>

  <view class="summary">
    <view class="summary-label">摘要</view>
    <view class="summary-text">{{article.summary}}</view>
  </view>

  <view class="related-section">
    <view class="section-title">继续阅读</view>
    <block wx:for="{{related}}" wx:key="id">
      <view class="related" bindtap="go" data-id="{{item.id}}">
        <image src="{{item.cover}}" mode="aspectFill" />
        <view class="related-copy">
          <view class="related-title">{{item.title}}</view>
          <view class="related-meta">{{item.category}} · {{item.author}}</view>
        </view>
        <view class="arrow">→</view>
      </view>
    </block>
  </view>
</view>