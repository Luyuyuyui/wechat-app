.head{padding-bottom:18rpx;border-bottom:1rpx solid #cbc7bf}
.tag{display:inline-block;font-size:18rpx;color:#8d3c3c;border:1rpx solid rgba(141,60,60,.25);padding:5rpx 12rpx;letter-spacing:2rpx;margin-bottom:14rpx}
.article-h{font-size:48rpx;margin-top:14rpx;letter-spacing:2rpx;line-height:1.25}
.meta{font-size:21rpx;color:#737981;margin-top:18rpx;letter-spacing:1rpx}

.cover{margin:30rpx -32rpx;height:430rpx;overflow:hidden}
.cover image{width:100%;height:100%;display:block}

.body{margin-top:14rpx}
.para{font-size:29rpx;line-height:2.1;margin-bottom:26rpx;color:#3f464e;text-indent:2em}

.summary{margin-top:40rpx;background:#e7e3da;padding:28rpx 30rpx;border-radius:6rpx}
.summary-label{font-size:20rpx;letter-spacing:3rpx;color:#8d3c3c;font-weight:600}
.summary-text{margin-top:10rpx;font-size:25rpx;line-height:1.85;color:#3f464e}

.related-section{margin-top:46rpx}
.related{display:flex;align-items:center;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #cbc7bf}
.related image{width:180rpx;height:120rpx;flex:none;border-radius:4rpx;display:block}
.related-copy{flex:1;min-width:0}
.related-title{font-size:26rpx;font-weight:700;line-height:1.4}
.related-meta{margin-top:6rpx;font-size:19rpx;color:#737981}
.arrow{color:#777;font-size:32rpx}