<view class="page">
  <view class="hero">
    <image src="{{work.cover}}" mode="aspectFill" />
    <view class="mask"></view>
    <view class="hero-info">
      <view class="tag">{{work.type}}</view>
      <view class="work-title">{{work.name}}</view>
    </view>
  </view>

  <view wx:if="{{work.images.length>1}}" class="section thumbs">
    <scroll-view scroll-x class="thumbs-row">
      <view class="th-thumb {{active===index?'on':''}}" wx:for="{{work.images}}" wx:key="*this" bindtap="thumb" data-i="{{index}}">
        <image src="{{item}}" mode="aspectFill" />
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-title">基本信息</view>
    <view class="intro">{{work.basicInfo}}</view>
  </view>

  <view class="section">
    <view class="section-title">创作背景与文化寓意</view>
    <view class="intro">{{work.meaning}}</view>
  </view>

  <view class="section">
    <view class="section-title">制作工艺</view>
    <view class="intro">{{work.process}}</view>
  </view>

  <view class="section honor-block">
    <view class="section-title">作品获奖与成果</view>
    <view class="intro">{{work.achievements}}</view>
  </view>

  <view class="section actions">
    <view class="ghost-btn" bindtap="craft">探索银饰锻造技艺　→</view>
    <view class="ghost-btn" bindtap="video">观看相关影像　→</view>
  </view>
</view>