.hero{position:relative;height:650rpx;margin:0 -32rpx;overflow:hidden}
.hero image{position:absolute;inset:0;width:100%;height:100%}
.hero .mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.0) 50%,rgba(0,0,0,.7) 100%)}
.hero-info{position:absolute;left:36rpx;right:36rpx;bottom:36rpx;color:#fff}
.hero-info .tag{display:inline-block;font-size:18rpx;letter-spacing:2rpx;background:rgba(141,60,60,.85);padding:6rpx 12rpx;margin-bottom:14rpx}
.work-title{font-size:56rpx;font-weight:700;letter-spacing:4rpx;text-shadow:0 4rpx 12rpx rgba(0,0,0,.35)}

.thumbs{margin-top:-32rpx;position:relative;z-index:2}
.thumbs-row{white-space:nowrap}
.th-thumb{display:inline-block;width:160rpx;height:160rpx;margin-right:14rpx;border-radius:4rpx;overflow:hidden;border:3rpx solid transparent;background:#faf8f3}
.th-thumb.on{border-color:#8d3c3c}
.th-thumb image{width:100%;height:100%;display:block}

.honor-block{background:#e7e3da;padding:30rpx;margin:30rpx -32rpx;border-radius:0}

.actions{margin-top:36rpx}
.actions .ghost-btn{display:block;text-align:center;margin-bottom:18rpx}