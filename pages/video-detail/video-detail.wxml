<view class="page"><view class="player" bindtap="play"><media type="VIDEO" label="视频素材待补充" height="490rpx" play="{{true}}"/></view><view class="section top"><view class="tag">{{video.category}}</view><view class="page-title title">{{video.title}}</view><view class="page-en">{{video.duration}}</view><view class="intro">{{video.description}}</view></view><view class="section source"><view class="section-title">素材信息</view><view>来源　{{video.source}}</view><view>拍摄时间　{{video.shotDate}}</view><view>拍摄地点　{{video.location}}</view></view><view wx:if="{{video.featured}}" class="section"><view class="section-title">纪录片章节</view><view class="chapter-list"><block wx:for="{{chapters}}" wx:key="*this"><view class="chapter"><view class="chapter-no">0{{index+1}}</view><view><view class="chapter-title">{{item}}</view><view class="intro">【纪录片素材待补充】</view></view><view class="time">--:--</view></view></block></view></view><view class="section"><view class="section-title">相关推荐</view><block wx:for="{{related}}" wx:key="id"><view class="related" bindtap="go" data-id="{{item.id}}"><view><view class="video-title">{{item.title}}</view><view class="video-meta">{{item.category}} · {{item.duration}}</view></view><text>→</text></view></block></view></view>
