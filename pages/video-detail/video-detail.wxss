.player{position:relative;margin:0 -32rpx;background:#000;height:490rpx;overflow:hidden}
.vd,.player-fallback{width:100%;height:100%;display:block}
.player-fallback{position:relative}
.player-fallback image{position:absolute;inset:0;width:100%;height:100%}
.player-fallback .mask{position:absolute;inset:0;background:rgba(0,0,0,.35)}
.player-fallback .play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:110rpx;height:110rpx;border-radius:50%;border:2rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:38rpx;background:rgba(0,0,0,.35);color:#fff}

.top{margin-top:35rpx}
.title{font-size:42rpx;margin:14rpx 0 4rpx}
.tag{display:inline-block;font-size:19rpx;color:#8d3c3c;border:1rpx solid rgba(141,60,60,.25);padding:6rpx 14rpx;letter-spacing:2rpx}

.source{background:#e7e3da;padding:28rpx;border-radius:6rpx;margin-top:30rpx}
.source .section-title{margin-bottom:14rpx}
.src-row{display:flex;justify-content:space-between;align-items:flex-start;padding:10rpx 0;font-size:24rpx}
.src-row text:first-child{color:#263750;font-weight:600;flex:none;width:140rpx;letter-spacing:2rpx}
.src-val{color:#555d66;line-height:1.7;text-align:right;flex:1}
.ours{color:#8d3c3c;font-weight:600}

.topic-list{margin-top:18rpx}
.topic-item{display:flex;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #cbc7bf}
.topic-no{font-size:20rpx;color:#8d3c3c;letter-spacing:2rpx;font-weight:600;width:60rpx;flex:none;padding-top:4rpx}
.topic-title{font-size:28rpx;font-weight:700}
.topic-text{margin-top:8rpx;font-size:24rpx;line-height:1.7;color:#555d66}

.honor-mini{background:#faf8f3;padding:24rpx 28rpx;border-radius:6rpx;font-size:24rpx;line-height:2;color:#3f464e;margin-top:14rpx}

.related{display:flex;align-items:center;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #cbc7bf}
.related image{width:180rpx;height:120rpx;flex:none;border-radius:4rpx;display:block}
.related-copy{flex:1;min-width:0}
.related-copy .video-title{font-size:26rpx;font-weight:700;line-height:1.4}
.related-copy .video-meta{margin-top:6rpx}
.arrow{color:#777;font-size:32rpx}