.tabs{margin:30rpx -32rpx 30rpx}
.tab-row{display:flex;gap:14rpx;padding:0 32rpx}
.tab{flex:none;padding:13rpx 22rpx;background:#e4e0d8;color:#737981;font-size:23rpx;border-radius:30rpx}
.tab.active{background:#223550;color:#fff}

.article-list{margin-top:18rpx}
.article{margin-bottom:30rpx;background:#faf8f3;border-radius:6rpx;overflow:hidden;box-shadow:0 6rpx 18rpx rgba(25,38,60,.06)}
.article-img{position:relative;height:280rpx}
.article-img image{width:100%;height:100%;display:block}
.article-tag{position:absolute;left:22rpx;top:22rpx;background:rgba(141,60,60,.9);color:#fff;font-size:18rpx;letter-spacing:2rpx;padding:6rpx 12rpx}
.article-copy{padding:24rpx 28rpx 28rpx}
.article-title{font-size:32rpx;font-weight:700;line-height:1.4;letter-spacing:1rpx}
.article-summary{margin-top:14rpx;font-size:24rpx;line-height:1.85;color:#555d66}
.article-meta{margin-top:16rpx;font-size:20rpx;color:#737981;letter-spacing:1rpx;border-top:1rpx solid #d1cdc5;padding-top:14rpx}