.home{padding-bottom:20rpx}.hero{height:880rpx;background:linear-gradient(150deg,#101d32,#314b62 58%,#9ba4a7);color:#fff;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:850rpx;height:850rpx;border:1rpx solid rgba(255,255,255,.16);border-radius:50%;right:-310rpx;bottom:-300rpx}.hero-top{padding:62rpx 42rpx;display:flex;justify-content:space-between;position:relative;z-index:1}.brand{font-size:31rpx;letter-spacing:6rpx}.brand-en{font-size:16rpx;letter-spacing:2rpx;opacity:.65;margin-top:10rpx}.hero-copy{position:absolute;z-index:1;left:42rpx;right:42rpx;bottom:82rpx}.light{color:#e5d5cd}.hero-name{font-size:68rpx;font-weight:700;margin-top:18rpx;letter-spacing:6rpx}.hero-sub{font-size:24rpx;opacity:.75;margin-top:8rpx}.hero-title{font-size:28rpx;letter-spacing:8rpx;margin-top:62rpx}.hero-desc{font-size:25rpx;margin-top:14rpx;opacity:.85}.explore{margin-top:34rpx;font-size:24rpx;border-bottom:1rpx solid rgba(255,255,255,.7);display:inline-block;padding-bottom:12rpx}.hero-note{position:absolute;right:32rpx;bottom:24rpx;font-size:17rpx;opacity:.5;z-index:1}.person-copy,.mini-copy{padding:25rpx}.person-name{font-size:40rpx;font-weight:700}.identity,.video-meta{font-size:20rpx;letter-spacing:1rpx;color:#777e87;margin:10rpx 0 18rpx}.process{border-top:1rpx solid #cbc7bf}.process-row{display:flex;align-items:center;border-bottom:1rpx solid #cbc7bf;padding:25rpx 4rpx}.stepno{font-size:20rpx;letter-spacing:2rpx;color:#8d3c3c;width:90rpx}.stepname{font-size:31rpx;font-weight:600;flex:1}.arrow{color:#687383}.video-scroll{white-space:nowrap;width:calc(100vw - 32rpx)}.video-row{display:flex;gap:20rpx}.mini-video{white-space:normal;width:410rpx;flex:none}.video-title{font-size:29rpx;font-weight:600}.work-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.work{font-size:24rpx;font-weight:600;line-height:1.5}.work .media{margin-bottom:13rpx}.culture-banner{background:#1b2a43;color:#fff;padding:38rpx;border-radius:6rpx}.culture-title{font-size:40rpx;font-weight:700;margin:14rpx 0}.culture-banner .intro{color:#e0e3e8}.culture-links{display:flex;justify-content:space-between;margin-top:32rpx;font-size:22rpx;color:#d8dbdd}.booklet{display:flex;justify-content:space-between;align-items:center;padding:36rpx;background:#e4e1da}.book-title{font-size:40rpx;font-weight:700;margin:12rpx 0}.book-cover{width:150rpx;height:210rpx;background:#243750;color:#fff;text-align:center;padding-top:20rpx;box-sizing:border-box;font-size:27rpx;line-height:1.55;letter-spacing:5rpx;box-shadow:12rpx 12rpx 0 #aeb2b4}.record{padding:34rpx 0;border-top:1rpx solid #bdb9b1;border-bottom:1rpx solid #bdb9b1}
