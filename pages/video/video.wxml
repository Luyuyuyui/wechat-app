<view class="page"><view class="eyebrow">MOVING IMAGE</view><view class="page-title">影像</view><view class="page-en">THE LIGHT OF HANDCRAFT</view><scroll-view scroll-x class="tabs"><view class="tab-row"><block wx:for="{{tabs}}" wx:key="*this"><view class="tab {{active===item?'active':''}}" bindtap="filter" data-tab="{{item}}">{{item}}</view></block></view></scroll-view><view class="documentary" bindtap="go" data-id="1"><media type="DOCUMENTARY" label="视频封面待补充" height="450rpx" play="{{true}}"/><view class="doc-copy"><view class="eyebrow">10–15 MIN · DOCUMENTARY</view><view class="doc-title">《银光淬炼》</view><view class="intro">用影像记录一门正在传承的技艺</view></view></view><view class="section"><view class="section-title">全部影像</view><block wx:for="{{videos}}" wx:key="id"><view wx:if="{{item.id!==1}}" class="video-card" bindtap="go" data-id="{{item.id}}"><media type="FILM" label="视频封面待补充" height="300rpx" play="{{true}}"/><view class="v-copy"><view class="video-title">{{item.title}}</view><view class="video-meta">{{item.category}} · {{item.duration}}</view><view class="intro">{{item.description}}</view></view></view></block></view></view>
