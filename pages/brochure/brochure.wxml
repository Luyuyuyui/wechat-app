<view class="book-page">
  <view class="switch" bindtap="switch">{{lang==='中文'?'中':'EN'}}　↔</view>

  <view class="cover">
    <image src="/assets/images/hero/cover-main.jpg" mode="aspectFill" />
    <view class="mask"></view>
    <view class="cover-inner">
      <view class="cover-byline">{{cover.byline}}</view>
      <view class="cover-en">ZHAN XIA SHENG HUA</view>
      <view class="cover-title">{{cover.title}}</view>
      <view class="cover-sub">{{cover.sub}}</view>
      <view class="cover-tag">{{cover.tag}}</view>
      <view class="cover-contact">{{cover.contact}}</view>
    </view>
  </view>

  <view class="content">
    <block wx:for="{{sections}}" wx:key="id">
      <view class="bk-section">
        <view class="eyebrow">{{item.eyebrow}}</view>
        <view class="bk-title">{{item.title}}</view>
        <view class="bk-line"></view>

        <block wx:for="{{item.body}}" wx:for-item="b" wx:key="*this">
          <view class="{{b.kind==='h' ? 'bk-h' : 'bk-p'}}">{{b.text}}</view>
        </block>
      </view>
    </block>

    <view class="end">
      <view class="end-line"></view>
      <view class="end-quote">{{end}}</view>
      <view class="end-text">{{lang==='中文'?'西北工业大学外国语学院暑期社会实践队 · 錾下生花·苗银新语':'NWPU School of Foreign Languages · Zhan Xia Sheng Hua'}}</view>
    </view>
  </view>
</view>