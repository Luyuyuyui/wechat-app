<view class="book-page">
  <view class="switch" bindtap="switch">{{lang==='中文'?'中':'EN'}}　↔</view>

  <view class="cover">
    <image src="/assets/images/hero/cover.jpg" mode="aspectFill" />
    <view class="mask"></view>
    <view class="cover-inner">
      <view class="cover-en">ZHAN XIA SHENG HUA</view>
      <view class="cover-title">錾下生花<br/>苗银新语</view>
      <view class="cover-sub">{{lang==='中文'?'双语非遗文化宣传册':'Bilingual ICH Booklet'}}</view>
    </view>
    <view class="cover-note">{{lang==='中文'?'宣传册主视觉 · 苗族银头饰':'Cover · Miao Silver Headdress'}}</view>
  </view>

  <view class="content">
    <view class="eyebrow">DIGITAL BOOKLET</view>
    <view class="page-title">{{lang==='中文'?'目录':'Contents'}}</view>
    <view class="page-en">06 CHAPTERS</view>

    <block wx:for="{{chapters}}" wx:key="eyebrow">
      <view class="chapter">
        <view class="chapter-eyebrow">{{item.eyebrow}}</view>
        <view class="chapter-body">
          <view class="chapter-title">{{item.title}}</view>
          <view class="chapter-text">{{item.text}}</view>
        </view>
      </view>
    </block>

    <view class="end">
      <view class="end-line"></view>
      <view class="end-text">{{lang==='中文'?'西北工业大学外国语学院暑期社会实践队 · 錾下生花·苗银新语':'NWPU School of Foreign Languages · Zhan Xia Sheng Hua'}}</view>
    </view>
  </view>
</view>