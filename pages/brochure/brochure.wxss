.book-page{min-height:100vh;background:#e6e2da;padding-bottom:60rpx;font-family:"Songti SC","SimSun","STSong",serif}
.switch{position:fixed;z-index:9;right:30rpx;top:30rpx;border:1rpx solid rgba(255,255,255,.85);color:#fff;padding:12rpx 20rpx;font-size:22rpx;border-radius:30rpx;background:rgba(0,0,0,.28);letter-spacing:1rpx}
.switch:active{background:rgba(0,0,0,.45)}

.cover{height:900rpx;color:#fff;position:relative;overflow:hidden}
.cover image{position:absolute;inset:0;width:100%;height:100%}
.cover .mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.10) 30%,rgba(0,0,0,.82) 100%)}
.cover-inner{position:relative;z-index:2;padding:80rpx 55rpx 70rpx;box-sizing:border-box;display:flex;flex-direction:column;justify-content:flex-end;min-height:100%}
.cover-byline{font-size:22rpx;letter-spacing:6rpx;opacity:.92;margin-bottom:8rpx}
.cover-en{font-size:20rpx;letter-spacing:6rpx;opacity:.78}
.cover-title{font-size:108rpx;font-weight:700;line-height:1.05;letter-spacing:10rpx;margin-top:36rpx;text-shadow:0 4rpx 18rpx rgba(0,0,0,.45);white-space:pre-line}
.cover-sub{margin-top:28rpx;font-size:24rpx;letter-spacing:2rpx;opacity:.92}
.cover-tag{margin-top:18rpx;font-size:22rpx;letter-spacing:2rpx;opacity:.88;white-space:pre-line;line-height:1.6}
.cover-contact{margin-top:26rpx;font-size:19rpx;letter-spacing:1rpx;opacity:.78;line-height:1.7;border-top:1rpx solid rgba(255,255,255,.35);padding-top:18rpx}

.content{padding:50rpx 34rpx 30rpx;background:#faf8f3;margin:-36rpx 24rpx 0;border-radius:6rpx;position:relative;z-index:3;box-shadow:0 10rpx 30rpx rgba(0,0,0,.10)}

.bk-section{padding:36rpx 0 40rpx;border-bottom:1rpx solid #d6d0c2}
.bk-section:last-of-type{border-bottom:none}
.bk-section .eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#8d3c3c;font-weight:700}
.bk-title{margin-top:12rpx;font-size:44rpx;font-weight:700;letter-spacing:3rpx;color:#1b2a43;line-height:1.2}
.bk-line{width:56rpx;height:2rpx;background:#8d3c3c;margin-top:18rpx;margin-bottom:24rpx;border-radius:2rpx}

.bk-h{margin:28rpx 0 8rpx;font-size:30rpx;font-weight:700;color:#2b3a55;letter-spacing:2rpx;line-height:1.4}
.bk-p{font-size:28rpx;line-height:2.0;color:#4a5258;margin-top:10rpx;letter-spacing:.5rpx}

.end{margin-top:50rpx;text-align:center;padding:30rpx 0 10rpx}
.end-line{width:72rpx;height:1rpx;background:#aeb1b2;margin:0 auto 24rpx}
.end-quote{font-size:28rpx;color:#2b3a55;letter-spacing:3rpx;line-height:1.7;font-weight:600}
.end-text{margin-top:20rpx;font-size:21rpx;letter-spacing:2rpx;color:#737981;line-height:1.7}