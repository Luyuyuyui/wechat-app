.book-page{min-height:100vh;background:#e6e2da;padding-bottom:50rpx}.switch{position:absolute;z-index:2;right:30rpx;top:30rpx;border:1rpx solid #fff;color:#fff;padding:12rpx 18rpx;font-size:22rpx}.cover{height:710rpx;background:#1e3049;color:#fff;padding:70rpx 55rpx;box-sizing:border-box;position:relative}.cover-en{font-size:19rpx;letter-spacing:5rpx;opacity:.7}.cover-title{font-size:100rpx;font-weight:700;line-height:1.1;letter-spacing:11rpx;margin-top:70rpx}.cover-sub{margin-top:25rpx;font-size:25rpx}.cover-note{position:absolute;bottom:34rpx;font-size:18rpx;opacity:.5}.content{padding:45rpx 32rpx}.chapter{display:flex;align-items:center;gap:25rpx;padding:25rpx 0;border-bottom:1rpx solid #c3bfb7;font-size:30rpx;font-weight:600}.chapter text:first-child{font-size:19rpx;color:#8d3c3c}.chapter text:last-child{margin-left:auto;color:#777}.empty{margin-top:42rpx}
