.book-page{min-height:100vh;background:#e6e2da;padding-bottom:50rpx}
.switch{position:absolute;z-index:3;right:30rpx;top:30rpx;border:1rpx solid rgba(255,255,255,.85);color:#fff;padding:12rpx 18rpx;font-size:22rpx;border-radius:30rpx;background:rgba(0,0,0,.25)}

.cover{height:780rpx;color:#fff;position:relative;overflow:hidden}
.cover image{position:absolute;inset:0;width:100%;height:100%}
.cover .mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.0) 40%,rgba(0,0,0,.85) 100%)}
.cover-inner{position:relative;z-index:2;padding:70rpx 55rpx;box-sizing:border-box}
.cover-en{font-size:20rpx;letter-spacing:6rpx;opacity:.85}
.cover-title{font-size:120rpx;font-weight:700;line-height:1.05;letter-spacing:12rpx;margin-top:60rpx;text-shadow:0 4rpx 18rpx rgba(0,0,0,.45)}
.cover-sub{margin-top:24rpx;font-size:26rpx;letter-spacing:2rpx}
.cover-note{position:absolute;left:55rpx;bottom:36rpx;font-size:19rpx;opacity:.6;z-index:2;letter-spacing:1rpx}

.content{padding:45rpx 32rpx;background:#faf8f3;margin:-30rpx 24rpx 0;border-radius:6rpx;position:relative;z-index:3;box-shadow:0 10rpx 30rpx rgba(0,0,0,.08)}
.chapter{padding:28rpx 0;border-bottom:1rpx solid #c3bfb7}
.chapter-eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#8d3c3c;font-weight:600}
.chapter-title{margin-top:10rpx;font-size:32rpx;font-weight:700;letter-spacing:1rpx}
.chapter-text{margin-top:10rpx;font-size:24rpx;line-height:1.85;color:#555d66}

.end{margin-top:46rpx;text-align:center}
.end-line{width:60rpx;height:1rpx;background:#aeb1b2;margin:0 auto 18rpx}
.end-text{font-size:21rpx;letter-spacing:2rpx;color:#737981}